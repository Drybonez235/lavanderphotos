---
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/contact/', label: 'Contact' },
];

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const current = normalize(pathname);
---

<header class="sticky top-0 z-50 border-b border-cream-200 bg-cream-50/90 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="text-xl/8 font-normal tracking-wide text-cream-700 uppercase font-baskerville focus-visible:outline-hidden focus-visible:ring-3 focus-visible:ring-lavender-400/60 rounded-md">
      Lavander Photos
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={current === link.href ? 'page' : undefined}
              class:list={[
                'text-base/7 font-bold transition-colors hover:text-lavender-700',
                current === link.href ? 'text-lavender-700 underline decoration-lavender-600 decoration-2 underline-offset-4' : 'text-plum-950',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      type="button"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Toggle menu"
      class="rounded-md p-2 text-plum-950 hover:bg-lavender-100 md:hidden"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-nav" class="hidden border-t border-cream-200 bg-cream-50 md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-6 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={current === link.href ? 'page' : undefined}
              class:list={[
                'block px-2 py-3 text-base/7 font-bold transition-colors hover:bg-lavender-100 hover:text-lavender-700',
                current === link.href ? 'text-lavender-700' : 'text-plum-950',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
