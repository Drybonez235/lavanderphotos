---
import type { Locale } from '../i18n/ui';
import { defaultLocale as DEFAULT_LOCALE, getT } from '../i18n/ui';

const SITE_DEFAULT_TITLE = 'Lavander Photos';
const SITE_DEFAULT_IMG = '/og-image.jpg'; // Real 1200x630 social card in public/

export interface BusinessInfo {
  name: string;
  legalName?: string;
  url: string;
  logo: string;
  description?: string; // falls back to a localized default
  telephone?: string;
  sameAs?: string[];
  address: {
    streetAddress?: string;
    addressLocality?: string; // City
    addressRegion?: string;   // State/Province (e.g., "NY")
    postalCode?: string;
    addressCountry: string;   // (e.g., "US")
  };
}
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  type?: 'website' | 'article';
  businessInfo?: BusinessInfo;
  publishedTime?: string;
  /** Full hreflang alternates (locale -> code) built by BaseHead. */
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

// Only publicly-known info lives here: nothing the site doesn't show.
const DEFAULT_BUSINESS_INFO: BusinessInfo = {
  name: 'Lavander Photos',
  url: 'https://lavanderphotos.com',
  logo: '/lavander-photos-logo-nobg.webp',
  sameAs: ['https://www.instagram.com/lavander.photos/'],
  address: {
    addressLocality: 'Chicago',
    addressRegion: 'IL',
    addressCountry: 'US',
  },
};

const {
  title = SITE_DEFAULT_TITLE,
  description,
  image = SITE_DEFAULT_IMG,
  type = 'website',
  businessInfo = DEFAULT_BUSINESS_INFO,
  publishedTime,
  locale = DEFAULT_LOCALE,
  alternates,
} = Astro.props;

const t = getT(locale);

// Localized fallbacks (used only when the page doesn't provide one).
const effectiveDescription = description ?? t('seo.defaultDescription');
const effectiveBusinessDescription = businessInfo.description ?? t('seo.defaultDescription');

const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);

// Pages pass fully-formed titles (e.g. "About | Lavander Photos"); bare titles
// (e.g. blog post names) get the brand appended.
const formattedTitle = title.includes(SITE_DEFAULT_TITLE) ? title : `${title} | ${SITE_DEFAULT_TITLE}`;

// hreflang alternates: absolute URLs, English doubles as x-default.
const HREFLANG_CODES: Record<Locale, string> = { en: 'en-US', es: 'es-MX' };
const alternateLinks = (Object.entries(alternates ?? {}) as [Locale, string][])
  .filter(([, path]) => Boolean(path))
  .map(([localeKey, path]) => ({ hreflang: HREFLANG_CODES[localeKey], href: new URL(path, Astro.site) }));
const xDefaultLink = alternates?.en ? new URL(alternates.en, Astro.site) : null;

const ogImageURL = new URL(image, Astro.site);

const jsonLD = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: businessInfo.name,
  legalName: businessInfo.legalName || businessInfo.name,
  url: businessInfo.url, // business site root
  logo: new URL(businessInfo.logo, Astro.site),
  image: ogImageURL,
  description: effectiveBusinessDescription,
  ...(businessInfo.sameAs?.length ? { sameAs: businessInfo.sameAs } : {}),
  ...(businessInfo.telephone ? { telephone: businessInfo.telephone } : {}),
  address: {
    '@type': 'PostalAddress',
    ...(businessInfo.address.streetAddress ? { streetAddress: businessInfo.address.streetAddress } : {}),
    ...(businessInfo.address.addressLocality ? { addressLocality: businessInfo.address.addressLocality } : {}),
    ...(businessInfo.address.addressRegion ? { addressRegion: businessInfo.address.addressRegion } : {}),
    ...(businessInfo.address.postalCode ? { postalCode: businessInfo.address.postalCode } : {}),
    addressCountry: businessInfo.address.addressCountry,
  },
};
---

<link rel="canonical" href={canonicalURL} />

{alternateLinks.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}
{xDefaultLink && <link rel="alternate" hreflang="x-default" href={xDefaultLink} />}

<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={effectiveDescription} />

<!-- Standard Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

<!-- Apple Touch Icon (Google often uses this for high-DPI displays) -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />


<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={effectiveDescription} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE_DEFAULT_TITLE} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={effectiveDescription} />
<meta name="twitter:image" content={ogImageURL} />

{jsonLD && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
)}
