---
import SEO from './SEO.astro';
import { defaultLocale, type Locale } from '../i18n/ui';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  businessInfo?: BusinessInfo;
  /** ISO datetime for article pages, rendered as article:published_time. */
  publishedTime?: string;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { title, description, image, type = 'website', businessInfo, publishedTime, locale = defaultLocale, alternates } = Astro.props;
---


<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      businessInfo={businessInfo}
      publishedTime={publishedTime}
      locale={locale}
      alternates={alternates}
    />
</head>