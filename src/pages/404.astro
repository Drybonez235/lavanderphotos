---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Page Not Found | Lavander Photos"
  description="This page could not be found."
  image="/images/home-og.jpg"
>
  <main class="min-h-dvh">
    <section class="bg-linear-to-br from-lavender-300 via-lavender-500 to-plum-700">
      <div class="mx-auto flex min-h-dvh max-w-4xl flex-col items-center justify-center px-6 py-24 text-center">
        <p class="text-xs/5 font-bold tracking-widest text-cream-100 uppercase">404</p>
        <h1 class="mt-4 font-baskerville text-5xl/13 font-bold text-white italic md:text-6xl/16">
          Out of Frame
        </h1>
        <p class="mx-auto mt-6 max-w-md text-lg/8 text-cream-100">
          The page you're looking for slipped out of the shot. Let's get you back to safety.
        </p>
        <a
          href="/"
          class="mt-10 rounded-full bg-white px-6 py-3 text-sm/6 font-bold text-plum-800 shadow-sm hover:bg-cream-100"
        >
          Back to home
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
