---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { alternatesFor, defaultLocale, getT, splitBlogId, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { locale: undefined }, props: { locale: 'en' as Locale, alternates: alternatesFor('/blog/') } },
    { params: { locale: 'es' }, props: { locale: 'es' as Locale, alternates: alternatesFor('/blog/') } },
  ];
}

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props as Props;
const t = getT(locale);

// Fetch the posts for this language only (collection ids look like "en/first-post")
const localePosts = (await getCollection('blog')).filter((entry) => splitBlogId(entry.id).locale === locale);

// Sort posts by publication date so the newest is always first
const sortedPosts = localePosts.sort((a, b) =>
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Extract the very newest post to use for the Featured layout slot
const featuredPost = sortedPosts[0];

// Group the remaining posts to safely populate the smaller grid items
const gridPosts = sortedPosts.slice(1);

// /blog/first-post/ for English, /es/blog/first-post/ for Spanish
const postHref = (id: string) => {
  const { slug } = splitBlogId(id);
  return locale === defaultLocale ? `/blog/${slug}/` : `/es/blog/${slug}/`;
};

const postDate = (entry: (typeof sortedPosts)[number]) =>
  entry.data.publishDate.toLocaleDateString(locale === 'es' ? 'es-MX' : 'en-US', { dateStyle: 'medium' });
---

<BaseLayout
  title={t('blog.indexTitle')}
  description={t('blog.indexDescription')}
  image="/og-image.jpg"
  locale={locale}
  alternates={alternates}
>
<main>
  <!-- Hero Section -->
  <section class="pt-24 pb-12 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">
        {t('blog.indexHeading')}
      </h1>
      <p class="text-xl text-gray-600">
        {t('blog.indexSub')}
      </p>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Dynamic Featured Post Section -->
      {featuredPost && (
        <div class="mb-12">
          <div class="bg-white rounded-xl shadow-lg p-8 border-l-4 border-[#4D90B5] hover:shadow-xl transition duration-300">
            <p class="text-sm font-semibold text-gray-500 mb-2 uppercase">{t('blog.featured')}</p>
            <h2 class="text-3xl font-bold text-gray-900 mb-4 hover:text-[#4D90B5] transition">
              <a href={postHref(featuredPost.id)}>
                {featuredPost.data.title}
              </a>
            </h2>
            <p class="text-gray-600 mb-4 leading-relaxed">
              {featuredPost.data.description}
            </p>
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2 text-sm font-medium text-gray-700">
                <span>{t('blog.by')} Jonathan Lewis</span>
                <span>&bull;</span>
                <time datetime={featuredPost.data.publishDate.toISOString()}>
                  {postDate(featuredPost)}
                </time>
              </div>
              <a href={postHref(featuredPost.id)}
                class="text-sm font-semibold text-[#4D90B5] hover:text-[#3a6d8e] transition">
                {t('blog.readArticle')} &rarr;
              </a>
            </div>
          </div>
        </div>
      )}

      <!-- Dynamic Post Grid -->
      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        {gridPosts.map((post) => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300 flex flex-col">
            <div class="p-6 flex-grow flex flex-col">
              <h3 class="text-xl font-bold text-gray-900 mb-3 hover:text-[#4D90B5] transition">
                <a href={postHref(post.id)}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-sm text-gray-500 mb-4">
                <time datetime={post.data.publishDate.toISOString()}>
                  {postDate(post)}
                </time>
              </p>
              <p class="text-gray-600 mb-4 flex-grow">
                {post.data.description}
              </p>
              <div class="mt-auto pt-4 border-t border-gray-100">
                <p class="text-sm font-medium text-gray-700 mb-3">
                  {t('blog.by')} Jonathan Lewis
                </p>
                <a href={postHref(post.id)} class="font-semibold text-[#4D90B5] hover:text-[#3a6d8e] transition">
                  {t('blog.readMore')} &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

</main>
</BaseLayout>