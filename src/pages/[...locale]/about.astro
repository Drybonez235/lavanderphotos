---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { alternatesFor, localizedPath, type Locale } from '../../i18n/ui';
import { about } from '../../i18n/pages/about';

export function getStaticPaths() {
  return [
    { params: { locale: undefined }, props: { locale: 'en' as Locale, alternates: alternatesFor('/about/') } },
    { params: { locale: 'es' }, props: { locale: 'es' as Locale, alternates: alternatesFor('/about/') } },
  ];
}

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props as Props;
const copy = about[locale];
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  image="/og-image.jpg"
  locale={locale}
  alternates={alternates}
>
  <main class="min-h-dvh">
    <!-- Header -->
    <section class="bg-linear-to-br from-lavender-200 via-lavender-400 to-plum-500">
      <div class="mx-auto max-w-3xl px-6 py-20 text-center md:py-28">
        <p class="text-xs/5 font-bold tracking-widest text-plum-800 uppercase">{copy.eyebrow}</p>
        <h1 class="mt-4 font-baskerville text-5xl/13 font-bold text-white italic md:text-6xl/16">
          {copy.heading}
        </h1>
        <p class="mt-6 text-lg/8 text-plum-950">{copy.intro}</p>
      </div>
    </section>

    <!-- Bio + polaroid collage -->
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="flex flex-col items-center gap-12 md:flex-row md:items-start md:gap-16">
        <div class="order-2 flex h-fit flex-1 justify-center gap-4 md:order-1 md:flex-col md:items-center">
          <figure
            class="relative z-0 w-40 rotate-2 bg-white p-3 shadow-xl shadow-plum-900/15 transition-transform duration-300 hover:z-10 hover:rotate-0 hover:scale-105 md:w-52"
          >
            <img
              src="/baby-on-couch-for-first-birthday-with-baloon.avif"
              alt={locale === 'es' ? 'Bebé en un sillón celebrando su primer cumpleaños con un globo' : 'Baby on a couch celebrating a first birthday with a balloon'}
              loading="lazy"
              class="aspect-square w-full object-cover"
            />
            <figcaption class="pt-2 text-center font-hand text-lg/6 text-plum-800">
              {locale === 'es' ? 'congelando la diversión' : 'freezing the fun'}
            </figcaption>
          </figure>
          <figure
            class="relative z-0 w-40 -rotate-3 bg-white p-3 shadow-xl shadow-plum-900/15 transition-transform duration-300 hover:z-10 hover:rotate-0 hover:scale-105 md:-mt-4 md:w-52"
          >
            <img
              src="/Baby-with-Red-Headband.avif"
              alt={locale === 'es' ? 'Bebé con una vincha roja' : 'Baby wearing a red headband'}
              loading="lazy"
              class="aspect-square w-full object-cover"
            />
            <figcaption class="pt-2 text-center font-hand text-lg/6 text-plum-800">
              {locale === 'es' ? 'solo sonrisas de verdad' : 'true smiles only'}
            </figcaption>
          </figure>
        </div>

        <div class="max-w-2xl">
          <h2 class="font-baskerville text-4xl/11 font-bold text-plum-950">
            {copy.freeze.heading}
          </h2>
          <p class="mt-6 text-lg/8 text-plum-950">
            {copy.freeze.p1Pre}
            <span class="font-bold text-plum-800">{copy.freeze.p1Bold}</span>
            {copy.freeze.p1Post}
          </p>
          <p class="mt-6 text-lg/8 text-plum-950">
            {copy.freeze.p2Pre}
            <span class="font-bold text-plum-800">{copy.freeze.p2Bold}</span>
          </p>

          <div class="mt-10 rounded-xl bg-lavender-100 p-8">
            <p class="text-lg/8 text-plum-950">
              {copy.freeze.highlightPre}
              <span class="font-display italic">{copy.freeze.highlightEm}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="bg-cream-100/70">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <h2 class="text-center font-baskerville text-4xl/11 font-bold text-plum-950">{copy.values.heading}</h2>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {
            copy.values.items.map((item) => (
              <div class="rounded-xl bg-white p-8 shadow-sm">
                <p class="font-hand text-2xl/8 text-lavender-700">{item.hand}</p>
                <p class="mt-3 text-base/7 text-plum-950">
                  {item.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-3xl px-6 py-20">
      <div class="flex flex-col items-center gap-4 border-t border-cream-200 pt-12 text-center">
        <p class="font-display text-2xl/9 font-bold text-plum-950 italic">{copy.cta.heading}</p>
        <p class="max-w-md text-base/7 text-cream-700">
          {copy.cta.sub}
        </p>
        <a
          href={localizedPath(locale, '/contact/')}
          class="mt-2 rounded-full bg-lavender-600 px-8 py-4 text-base/7 font-bold text-white shadow-sm hover:bg-lavender-700 focus-visible:outline-hidden focus-visible:ring-3 focus-visible:ring-lavender-400/60"
        >
          {copy.cta.bookBtn}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
